# Opcional localmente; recomendado para passar de 60 para 5.000 requests/hora no GitHub.
GITHUB_TOKEN=
PORT=3001
DATABASE_URL="postgresql://github_ocean:github_ocean_dev@localhost:5432/github_ocean?schema=public"
WEB_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
# Crie em https://github.com/settings/developers com callback http://localhost:3001/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Gere valores longos e aleatórios diferentes para cada segredo.
SESSION_SECRET=
CRON_SECRET=
ANALYTICS_SECRET=
# Deixe vazio quando frontend e API estiverem no mesmo domínio (caso padrão na Vercel).
VITE_API_ORIGIN=
